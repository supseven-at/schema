{
    "name": "supseven/schema",
    "description": "A simple utility class for implementing schema.org data from several types",
    "type": "typo3-cms-extension",
    "license": [
        "GPL-2.0-or-later"
    ],
    "version": "1.0.1",
    "require": {
        "typo3/cms-core": "^13.0 || ^14.0",
        "spatie/schema-org": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Supseven\\Schema\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "schema"
        }
    }
}
